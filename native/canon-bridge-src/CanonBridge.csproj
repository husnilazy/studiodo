<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>canon-bridge</AssemblyName>
    <RootNamespace>StudiodoCanonBridge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8981;CS0649;CS0169;SYSLIB1054;CS8618</NoWarn>
  </PropertyGroup>

  <!-- Canon's wrapper + 64-bit DLLs live in ./sdk (gitignored; run setup-sdk.ps1). -->
  <ItemGroup>
    <Compile Remove="sdk\**" />
    <Compile Include="sdk\EDSDK.cs" />
    <None Include="sdk\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
