# Database Postgres (shared cloud backend — bisa provider apa saja: Neon/Supabase/RDS/dll)
DATABASE_URL=postgresql://user:password@localhost:5432/studiodo

# Secret untuk sign JWT admin — WAJIB diisi string acak panjang di production
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=4050
PUBLIC_BASE_URL=http://localhost:4050

# Keep the database compute warm (relevant for serverless Postgres like Neon,
# which auto-suspends after a few idle minutes and pays a multi-second
# cold-start on the next query). Default: on, pinged every 4 minutes.
# Set to false to let it suspend normally (saves compute-hours on a free tier,
# at the cost of an occasional slow first request).
# KEEP_DB_WARM=false
# KEEP_DB_WARM_INTERVAL_MS=240000

# Xendit: setiap tenant WAJIB mengisi Secret Key & Webhook Token sendiri lewat
# Admin → Pembayaran QRIS Xendit (disimpan di tenant_settings) — sengaja tidak
# ada fallback env global, karena itu berarti semua tenant yang belum setup
# berbagi satu akun/secret Xendit yang sama (celah forge webhook lintas tenant).
PAYMENT_DEMO_MODE=true

# Storage default driver preference: local | r2 | gdrive — tenants without any
# storage config yet fall back to this (not to a shared bucket/folder: R2/Drive
# CREDENTIALS have no env fallback at all, only this driver preference does).
# "local" needs no further config. To actually use r2/gdrive, each tenant must
# enter their own credentials via Admin → Storage — there is intentionally no
# way to configure a shared R2/Drive credential here, since that would mean
# every tenant without their own setup silently shares one bucket/folder.
STORAGE_DRIVER=local
