# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/studiodo

# Server
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Xendit — opsional; kredensial produksi bisa diisi dari Admin → Pembayaran QRIS Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
PAYMENT_DEMO_MODE=true

# Storage: local | r2 | gdrive
STORAGE_DRIVER=local

# Cloudflare R2, dipakai jika STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_PREFIX=studiodo

# ─── Google Drive Storage ──────────────────────────────────────────────────────
# Dipakai jika STORAGE_DRIVER=gdrive
# 
# GOOGLE_SERVICE_ACCOUNT_JSON: Paste isi file JSON dari Google Cloud Console
#   → IAM & Admin → Service Accounts → studiodo-kiosk-drive → Keys → Add Key → JSON
#   Paste satu baris (minify JSON), contoh:
#   GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"studiodo-photobooth","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"studiodo-kiosk-drive@studiodo-photobooth.iam.gserviceaccount.com",...}
#
# GOOGLE_DRIVE_FOLDER_ID: ID folder Drive yang menjadi root penyimpanan
#   → Buka folder di Google Drive → copy ID dari URL: drive.google.com/drive/folders/[INI_ID_NYA]
#   → Pastikan folder sudah di-share ke email service account sebagai Editor
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
