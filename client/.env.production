# Baked into the production build only (npm run build:client / npm run dist).
# Dev (npm run dev) is unaffected — Vite doesn't load this file in dev mode,
# and dev keeps proxying the relative "/api" to the local server as before.
#
# This is what lets a freshly installed .exe (no server on that machine,
# no kiosk pairing done yet) reach admin login etc. immediately, instead of
# a relative "/api" that resolves to nowhere against a file:// page. Kiosk
# pairing (Setup kiosk screen) can still override this per-device for a
# tenant on a different deployment.
VITE_DEFAULT_API_BASE_URL=https://qr.studiodo.id/api
